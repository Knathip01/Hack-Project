# ===================================================
# Photharam Beetle Shop — Security Audit Tool Config
# ===================================================

# สร้าง token แบบสุ่มยาวๆ (ห้าม commit ค่าจริง)
# ตัวอย่าง: openssl rand -hex 32
AUDIT_TOKEN=replace-with-a-long-random-secret

# โดเมนที่อนุญาตให้ตรวจ (คั่นด้วย comma สำหรับหลายโดเมน)
AUDIT_ALLOWED_HOSTS=photharam-beetle-2027.vercel.app
